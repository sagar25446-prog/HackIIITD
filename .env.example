# Copy to .env and fill in. Never commit .env.
# TinyFish API key: create one at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=sk-tinyfish-lNn6ZoUDZYeXtztA1QYU58hMX8xWuPt_
# live = always call TinyFish · replay = only recorded real runs (offline demo) · auto = live, fall back to replay
TINYFISH_MODE=auto
# Optional: Claude writes grounded answers and extracts rules. Without it JAAGRUK uses deterministic fallbacks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional: public https URL of this server (e.g. a tunnel) so TinyFish Monitors can call /api/radar/webhook
PUBLIC_BASE_URL=
# Exit country for TinyFish browsers/agents (Indian government portals often block foreign IPs)
TINYFISH_PROXY_COUNTRY=IN
# Agent limits (cost control). max_steps is used only if your account has it enabled.
AGENT_MAX_SECONDS=180
AGENT_MAX_STEPS=30
ALLOW_STEALTH_RETRY=true
# Team-only approval of public rule changes. Keep this out of the frontend and shared links.
JAAGRUK_REVIEW_KEY=
